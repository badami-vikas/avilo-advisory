{
  "name": "@avilo/api",
  "version": "1.9.3",
  "private": true,
  "type": "module",
  "description": "Local Fastify + tRPC surface over SQLite. Binds to 127.0.0.1 only; makes no outbound requests.",
  "main": "./src/server.ts",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "seed:demo": "tsx src/scripts/seed-demo.ts",
    "migrations:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@avilo/core": "workspace:*",
    "@avilo/module": "workspace:*",
    "@avilo/tables": "workspace:*",
    "@bridge/module-host": "workspace:*",
    "@fastify/cors": "^10.0.1",
    "@fastify/formbody": "^8.0.2",
    "@fastify/multipart": "^9.0.3",
    "@fastify/static": "^10.1.2",
    "@trpc/server": "^11.0.0",
    "better-sqlite3": "^13.0.1",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.2.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.5",
    "drizzle-kit": "^0.31.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5",
    "xlsx": "^0.18.5"
  }
}
