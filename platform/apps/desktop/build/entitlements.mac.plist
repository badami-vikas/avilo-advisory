<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!--
      The hardened runtime blocks the JIT and the unsigned-memory execution that
      Chromium's JavaScript engine needs. These two are the standard Electron pair and
      nothing more is granted: no network server entitlement, no camera, no microphone,
      no address book. The application talks to 127.0.0.1 and to the user's own files.
    -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
  </dict>
</plist>
